{
  "name": "auradesk",
  "version": "1.0.0",
  "description": "Desktop wallpaper discovery, collections and context-aware automation",
  "main": "electron/main/index.js",
  "author": "AuraDesk Team",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"wait-on tcp:5173 && npm run dev:electron\"",
    "dev:frontend": "npm.cmd --prefix frontend run dev",
    "dev:electron": "electron .",
    "build:frontend": "npm.cmd --prefix frontend run build",
    "build": "npm run build:frontend && electron-builder",
    "install:all": "npm.cmd install && npm.cmd --prefix frontend install",
    "rebuild": "electron-builder install-app-deps"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "axios-retry": "^4.5.0",
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "googleapis": "^144.0.0",
    "node-cron": "^3.0.3",
    "p-limit": "^6.2.0",
    "sharp": "^0.33.5",
    "wallpaper": "^7.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.1",
    "@types/node-cron": "^3.0.11",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "wait-on": "^8.0.2"
  }
}
